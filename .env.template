# ─────────────────────────────────────────────────────────────────────────────
# SECRET RESOLUTION — READ BEFORE EDITING
# This file is COMMITTED and PUBLIC. It must never contain a real secret value.
# Every secret below is the sentinel `@bws`; scripts/render_env.sh resolves each
# one from Bitwarden Secrets Manager (by the exact variable name) at deploy time
# and writes the real, gitignored .env. Non-secret config lines are literal and
# used as-is. To add a secret: store it in the `ai-trading-bot` Bitwarden project
# under the same name, then set its line here to `@bws`.
# See decisions/2026-09-27_bitwarden-secret-resolution.md.
# ─────────────────────────────────────────────────────────────────────────────

# IBKR Live Account (credentials for ib-gateway container)
# Mandatory broker safety: completed account-scoped inventory and open-order
# requests use 10-second timeouts; cancellation acknowledgement waits up to
# 10 seconds. These guards cannot be disabled through environment settings.
# See decisions/2026-09-30_broker-confirmed-sell-safety.md.
IBKR_ACCOUNT=@bws
# Calibration artifact approval also requires this explicit account to match
# the recorded experiment; an unknown account cannot receive a deployment approval.
IBKR_LIVE_USER=@bws
IBKR_LIVE_PASS=@bws
IBKR_TOTP_SECRET=@bws

# IBKR Flex Query (cash deposit sync for performance report)
IBKR_FLEX_TOKEN=@bws
IBKR_FLEX_QUERY_ID=@bws
# IBKR_FLEX_EXEC_QUERY_ID — TradeConfirmSync Activity Flex Query for fill-history diagnostics
# Unscoped aggregates cannot automatically close a portfolio ledger row.
IBKR_FLEX_EXEC_QUERY_ID=@bws

# Supabase (database)
SUPABASE_URL=@bws
SUPABASE_KEY=@bws
# Dedicated server-side service-role key for private intraday account snapshots.
# Store this key in Bitwarden BEFORE deploying the intraday capture feature.
INTRADAY_SUPABASE_KEY=@bws

# Dashboard permission for NEW real buys defaults OFF in persistent local storage.
# Configure a random private token of at least 32 characters to unlock the UI.
# Blank keeps the switch locked; it does not change a previously saved permission.
# For Bitwarden management, create TRADING_CONTROL_TOKEN and replace blank with @bws.
# Also authorizes research-inbox decisions and approved artifact downloads.
TRADING_CONTROL_TOKEN=
# Compose pins this path identically for the dashboard and real execution agent.
TRADING_CONTROL_PATH=/app/control/trading-control.sqlite3

# Passive research capture. Does not change live trading rules.
# Deployment runs protection, observer and shadow together. TRADING_RUNTIME_MODE
# observe/live remains accepted for compatibility but never enables real buys.
# The standalone observer uses its own spool /app/logs/intraday_observer.sqlite3
# and CLI client ID 71; this enable flag controls embedded execution recording.
# See docs/intraday_research.md and decisions/2026-09-30_observer-and-calibration-harness.md.
INTRADAY_CAPTURE_ENABLED=true
INTRADAY_SAMPLE_SECONDS=300
INTRADAY_RETENTION_DAYS=365
INTRADAY_MAX_SYMBOLS=250
INTRADAY_MAX_QUOTE_AGE_SECONDS=600
INTRADAY_CAPTURE_SPOOL=/app/logs/intraday_capture.sqlite3
# Automatic actual-decision comparisons require recorded decision frames;
# legacy runtime labels and the real-entry switch do not gate research.
# Observation/shadow daily and weekly reports use the independent cloud workflow.
INTRADAY_AUTO_COMPARE=true
INTRADAY_REPLAY_MAX_DAYS=93
# Optional dedicated read-only key for the shadow worker's source-table reads.
# Blank uses INTRADAY_SUPABASE_KEY; research writes always use the private key.
SHADOW_SOURCE_SUPABASE_KEY=
# Automatic research uses private cloud settings, not live environment overrides:
# enabled=true, training_sessions=5, evaluation_sessions=5, max_candidates=16,
# risk_policy=null. Set explicit risk/evidence limits in the research inbox BEFORE
# a new campaign; null permits exploration but blocks deployment recommendations.
# Reuses the private research key, dashboard token and Telegram recipients.
# See docs/interactive_calibration.md and decisions/2026-10-03_interactive-self-calibration.md.
# Risk diagnostics use historical 3-month Treasury yields, not a new env setting:
# 252 daily periods/year, ACT/365 cash proxy, strictly prior observation <=7 days old.
# At least 2 daily returns for dispersion; 20 for empirical 95% tail estimates.
# Rates/source hashes are frozen in proposals. Missing rates never become 0%.
# Outbound HTTPS to fred.stlouisfed.org for H.15 DGS3MO; no new API secret.
# TLS stays verified; bounded 8s requests, 2 MiB responses, 31-day lookback.
# See decisions/2026-10-03_calibration-risk-metrics.md.

# FMP (Financial Modeling Prep — market data for technical screener)
FMP_API_KEY=@bws

# OpenAI (AI trigger ranking) — optional; leave blank to disable. If used, store
# it in Bitwarden as OPENAI_API_KEY and change this line to `@bws`.
OPENAI_API_KEY=

# Telegram (trade alerts and notifications)
TELEGRAM_BOT_TOKEN=@bws
TELEGRAM_CHAT_IDS=@bws

# ── Execution-agent log shipping to Supabase (agent_logs) ────────────────────
# The full agent log is shipped to Supabase so it can be read from anywhere --
# the production host is often unreachable from the network the question is
# being asked from. Every line is redacted on the host first (IBKR account
# numbers, bot tokens, JWTs, Supabase sb_publishable_/sb_secret_ keys,
# key=value secrets). The local file at /app/logs is the complete record and is
# kept 7 days regardless. Redaction is the PRIMARY control on what leaves the
# host: agent_logs is readable by any holder of the publishable key, on the same
# terms as every other table here.
# See decisions/2026-09-18_comprehensive-log-shipping.md and
# decisions/2026-09-18_agent-logs-rls-blocked-writes.md.
#
# Set to false to ship only problem lines ([TELEGRAM-FAIL], CRITICAL,
# Traceback, ❌, ⚠️) -- much smaller, much less useful for debugging.
AGENT_LOG_SHIP_ALL=true
# Retention is tiered: routine chatter expires fast, errors are kept for a
# post-mortem. MAX_ROWS is a hard ceiling regardless of age, because age-based
# retention cannot bound a burst occurring between two hourly sweeps.
AGENT_LOG_RETENTION_DAYS=14
AGENT_LOG_INFO_RETENTION_DAYS=3
AGENT_LOG_MAX_ROWS=250000
AGENT_LOG_BUFFER_MAX=20000
# Research operational diagnostics independently use SUPABASE_KEY for agent_logs,
# not the private INTRADAY_SUPABASE_KEY (unless SUPABASE_KEY is absent).
# They are always enabled by production research_entrypoint.py, independent of
# AGENT_LOG_SHIP_ALL. No raw research/account payloads or credentials are logged.
# The research watchdog also needs the ordinary SUPABASE_KEY Actions secret.
# See docs/intraday_research.md and decisions/2026-10-03_independent-research-diagnostics.md.

# Portfolio & risk settings
MAX_POSITIONS=5
MIN_POSITION_SIZE=5000.0
# Base trailing stop floor, measured from the position's PEAK. Matches
# config.py; was 0.07 here, which disagreed with the 0.10 the agent runs.
STOP_LOSS_PCT=0.10

# Absolute broker-enforced max loss for the pre-proven/unarmed window. A static
# OCA hard stop rests at entry*(1-MAX_LOSS_PCT) so a bot disconnect cannot let a
# fresh position drift to the full ATR base trail. 7% was shown FREE in normal
# operation by the 2026-09-07 --basetrail replay; 5% clipped winners.
MAX_LOSS_PCT=0.07

# Reconcile overwrites the stored buy_price when it drifts more than this fraction
# (1%) from what the lot actually cost. The basis comes from the BOT fills that
# opened the lot; IBKR's averageCost is only a fallback, and is refused when the
# symbol has been round-tripped (it then folds earlier realised losses into the
# open lot -- the NTRA incident: averageCost said 331.70, the real fill was
# 317.4295, and a +$218 winner was booked as a -$650 loss).
BUY_PRICE_DRIFT_TOLERANCE=0.01

# ── The Prove-It Stop ─────────────────────────────────────────────────────────
# One rule, one question: has this position ever CLOSED above what we paid?
#   Phase 1 (unproven) anchors to ENTRY and never expires.
#   Phase 2 (proven)   anchors to the PEAK once the arming gain is reached.
# See docs/sell_logic.md and decisions/2026-09-04_prove-it-stop.md.
PROVE_IT_ENABLED=true
# Phase 1 band below entry. It WIDENS after day 0 on purpose — holding the tight
# band through day 1 clips winners for more than it saves on losers.
PROVE_IT_P1_DAY0_PCT=0.01
PROVE_IT_P1_LATER_PCT=0.03
PROVE_IT_P1_DAY0_LAST_DAY=0
# Phase 2: peak gain that arms the give-back floor, and where the floor sits
# relative to entry. NEGATIVE = below entry, and it must stay negative: an
# exact-breakeven floor flushes any position that pokes green and retests entry.
PROVE_IT_P2_ARM_GAIN_PCT=0.02
PROVE_IT_P2_FLOOR_PCT=-0.01
# Applies ONLY to the Phase 2 armed give-back floor: the resting IBKR order sits
# one slack below it. Phase 1 no longer uses this — its resting STP sits AT the
# band (IBKR is the primary enforcer), see
# decisions/2026-09-26_phase1-broker-primary-stop.md.
PROVE_IT_BACKSTOP_SLACK_PCT=0.01

# ── Partial scale-out (winner give-back reducer) ─────────────────────────────
# The first time a position's PEAK gain reaches SCALE_OUT_TRIGGER_PCT, sell
# SCALE_OUT_FRACTION of the shares at market and let the remainder ride the
# unchanged Prove-It stop. Fires once per position; suppressed for power-held
# leaders. PROVISIONAL — +4%/33% tuned on a 33-trade replay; revisit at >=50
# trades (decisions/provisional_decisions.json). See
# decisions/2026-09-08_partial-scale-out.md.
SCALE_OUT_ENABLED=true
SCALE_OUT_TRIGGER_PCT=0.04
SCALE_OUT_FRACTION=0.33

# Exit-rule shadow logger — MEASUREMENT ONLY, never places or changes an order.
# Every monitor cycle, records to Supabase (exit_shadow_log) what two
# register-tracked exit candidates WOULD do to each open position: Q1 = Phase 2
# arms at +3% instead of +2%; Q2 = a 5% give-back trail from the high-water mark
# instead of the 1.5% profit-lock. Feeds the exit-parameters-proveit and
# ladder-width-runon reviews with live, out-of-regime evidence the 5-minute
# backtest cannot produce. Zero trading impact; safe to leave on. Requires
# migrations/20260927_add_exit_shadow_log.sql (no-ops silently until applied).
# See decisions/2026-09-27_exit-shadow-log.md.
EXIT_SHADOW_LOG_ENABLED=true


# Trading days without a new high before a position counts as STALE. Staleness
# no longer sells to cash — it discounts the Rank & Replace margin to
# RANK_REPLACE_FAIL_THRESHOLD, so the slot is released only when somewhere
# better to put the money exists.
STALE_EXIT_DAYS=10
STALE_EXIT_MIN_DAYS_HELD=7
# Days a ticker is ineligible for re-entry after being sold. 3, not 7, and not
# 0: 7 blocks 7 of the bot's 9 genuine re-entries (+$1,736.67 net, including
# NTRA's +$575.44), while 0 lets 62% of blocked re-entries back in on names that
# break the Prove-It day-0 band on their first session. As of 2026-09-26 the
# block is REASON-AWARE: this window applies only to LOSS exits; a profit sale on
# a prior day is not blocked, and a same-session re-buy is always blocked. See
# decisions/2026-09-15_cooling-off-three-days.md and
# decisions/2026-09-26_reason-aware-cooling-off.md.
COOLING_OFF_DAYS=3

# Earnings blackout: defer opening a new position when its next scheduled earnings
# report is within this many NYSE trading days. A fresh position sits under the
# Prove-It stop's tight -1%/-3% floor, so an earnings gap is close to a guaranteed
# stop-out plus a cooling-off lockout. Deferral (not a veto — the breakout can be
# re-bought after the report) and it FAILS OPEN on a missing/past date so a
# per-name data gap never blocks every buy. See
# decisions/2026-09-28_earnings-blackout-and-news-veto.md.
EARNINGS_BLACKOUT_TRADING_DAYS=3

# Buy gating
TRIGGER_LOOKBACK_DAYS=3
MAX_PIVOT_EXTENSION=0.05
MIN_TRIGGER_SCORE=60
MIN_PRE_BREAKOUT_SCORE=65
MIN_RELAXED_TRIGGER_SCORE=58

# CANSLIM "M" — market direction gate (buys only; never forces an exit)
# Bullish requires EVERY ticker >BUFFER_PCT above its SMA-200, AND at least one
# of those SMA-200s non-falling over SLOPE_DAYS sessions. Every error path
# (HTTP failure, bad payload, short history, stale data, exception) is bearish.
# Setting MARKET_DIRECTION_FILTER_ENABLED=false is the only bypass.
# See decisions/2026-09-28_market-gate-spy-only-tighter-band.md (retune to
# SPY-only / 0.5% band) and decisions/2026-08-22_market-direction-gate-spy-qqq.md
MARKET_DIRECTION_FILTER_ENABLED=true
MARKET_DIRECTION_TICKERS=SPY
MARKET_DIRECTION_SMA_WINDOW=200
MARKET_DIRECTION_BUFFER_PCT=0.005
MARKET_DIRECTION_SLOPE_DAYS=20
MARKET_DIRECTION_MAX_STALE_DAYS=5

# Technical screener
SMA_WINDOW=50
VOLUME_SURGE_MIN=1.50
ROLLING_HIGH_WINDOW=252
PIVOT_PROXIMITY=0.95
TRIGGER_PRUNE_DAYS=56
# Phase 3 quality gate: skip stocks with RS vs SPY below this threshold (0-100 scale)
# NOT a percentile of the candidate field, despite O'Neil's "top 50%" framing:
# rs_score is a clipped transform of 12-week excess return vs SPY, where
#   50  = matched SPY exactly (excess 0%)
#   100 = beat SPY by >= 10% (and everything above that clips to 100 as well)
# So 50 admits any candidate that did not underperform the index.
# See docs/technical_triggers.md#relative-strength.
RS_MIN_GATE=50
PRE_BREAKOUT_SCORE_BOOST=0
DAILY_TRIGGER_TARGET=4
RELAXED_PRE_BREAKOUT_PROXIMITY=0.10
RELAXED_PRE_BREAKOUT_VOL_MAX=1.10
RELAXED_PRE_BREAKOUT_UPTREND_MIN=2
RELAXED_RS_MIN_GATE=50
LEARNING_MIN_ROWS=3
LEARNING_LOOKBACK_DAYS=90
# Hard cap on the breakout failure penalty, in score points. 0 = DISABLED.
# Measured 2026-09-17 as non-discriminative: replayed over all 16
# breakout_learnings rows it scored every trade at the cap -- all 10 winners
# (LPG +6.47%, ECO +5.35%, DHT +3.47%) and all 6 losers identically. Raising
# this re-enables a filter that removes winners and losers at the same rate.
# See decisions/2026-09-17_failure-penalty-disabled.md
FAILURE_PENALTY_MAX_POINTS=0
HISTORY_LEARNING_MAX_TRADES=3
HISTORY_LEARNING_MAX_PENALTY=12

# ── Backtest cost model (research/strategy_backtest.py + backend/backtester.py) ─
# Commission + slippage charged to the backtest CASH balance only, so the equity
# curve / CAGR / final equity are NET while each trade's profit_loss stays GROSS
# (quote-to-quote) and the exit RULES are never perturbed. These are ASSUMPTIONS,
# not measured fill quality; they only affect BACKTESTS, never live trading.
# The exit-review harness (research/exit_rule_replay.py) stays gross by design.
# See decisions/2026-09-29_backtest-costs-slippage.md and docs/backtesting.md.
# IBKR tiered US-equity default: $0.0035/share, $0.35 per-order floor. The item
# #3 roadmap cites ~0.65¢/share as a conservative all-in figure -> set 0.0065.
BACKTEST_COMMISSION_PER_SHARE=0.0035
BACKTEST_COMMISSION_MIN=0.35
# Adverse slippage per fill, in basis points (1 bp = 0.01%). Placeholder, not a
# measurement; buys fill higher and sells lower by this amount.
BACKTEST_SLIPPAGE_BPS=5.0
