FROM python:3.12-slim
LABEL io.ai-trading-bot.live-entry-gate="1"

WORKDIR /app

ARG GIT_COMMIT=unknown
ARG BUILD_TIME=unknown
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    GIT_COMMIT=${GIT_COMMIT} \
    BUILD_TIME=${BUILD_TIME}

# Install python dependencies directly
RUN pip install --no-cache-dir \
    ib-insync==0.9.86 \
    supabase==2.31.0 \
    requests==2.32.3 \
    pandas==2.2.2 \
    httpx==0.28.1 \
    openai>=1.0.0

# Copy script files into the container (include trigger_audit for execution_agent import)
COPY agent_entrypoint.py execution_agent.py execution_agent_ref.py exit_rules.py exit_shadow.py exit_shadow_store.py indicators.py market_calendar.py \
     market_regime.py sentiment.py ibkr_data.py orders.py \
    trade_history.py fills.py reconciliation.py buying.py decision_core.py \
    monitoring.py selling.py agent_logging.py \
     telegram_notifier.py force_buy.py force_sell.py managed_exit.py scoring.py config.py \
     trigger_audit.py schema_guard.py flex_query_sync.py cooling_off.py ./
COPY intraday_capture.py intraday_observer.py quote_transport.py exit_core.py trade_costs.py broker_positions.py ./
COPY research_configuration.py market_direction.py ./
COPY trading_control.py restart_and_health_check.py ./
COPY research_diagnostics.py research_entrypoint.py ./

# Execute the agent via the fatal-safe wrapper: it ships any startup crash
# (including import-time errors, before log shipping is up) to Supabase
# agent_logs, so a boot failure is diagnosable without SSHing into the host.
# See decisions/2026-09-27_startup-crash-shipping.md.
CMD ["python", "research_entrypoint.py", "execution-agent"]
